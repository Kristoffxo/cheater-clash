# Copy this file to `.env` and paste your own keys in.
# `.env` is gitignored. Do not paste these values into a chat window — not to me,
# not to anyone. Anyone holding them can read your transactions.

# ─── Cashfree (for automatic payment verification) ───────────────────────────
# Dashboard → Developers → API Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# "sandbox" while testing, "production" once your KYC clears
CASHFREE_ENV=sandbox

# Dashboard → Developers → Webhooks. Point it at https://<your-domain>/api/webhook/cashfree
# and paste the signing secret Cashfree shows you here.
CASHFREE_WEBHOOK_SECRET=
